{
  "compilerOptions": {
    "types": [],
    "lib": ["ES2020", "DOM"],
    "declaration": true,
    "outDir": "./lib",
    "sourceMap": true,
    "inlineSources": true,
    "target": "ES6",
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "strict": false,
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules/*",
    "__sapper__/*",
    "public/*"
  ],
}
